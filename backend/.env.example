# Copiar este archivo a .env y completar los valores reales. .env no se sube al repositorio.

DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Autenticación (JWT en cookie httpOnly)
JWT_SECRET="reemplazar-por-un-valor-aleatorio-largo"
JWT_EXPIRES_IN="1d"

# Origen permitido para CORS con credenciales (cookies). Ajustar al dominio real del frontend.
CORS_ORIGIN="http://localhost:5173"
